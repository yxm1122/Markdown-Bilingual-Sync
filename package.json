  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "translation",
    "translate",
    "bilingual",
    "i18n",
    "localization",
    "documentation",
    "technical-writing",
    "ai",
    "openai",
    "llm",
    "glossary",
    "copilot",
    "agent",
    "vscode-extension"
