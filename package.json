{
  "name": "markdown-bilingual-sync",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.14.0",
  "publisher": "yxm1122",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxm1122/Markdown-Bilingual-Sync.git"
  },
  "homepage": "https://github.com/yxm1122/Markdown-Bilingual-Sync#readme",
  "bugs": {
    "url": "https://github.com/yxm1122/Markdown-Bilingual-Sync/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "translation",
    "translate",
    "bilingual",
    "i18n",
    "localization",
    "ai",
    "openai",
    "llm",
    "glossary",
    "vscode-extension"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:skill"
  ],
  "l10n": "./l10n",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownBilingualSync.translateFile",
        "title": "%command.translateFile.title%",
        "category": "%command.category%",
        "icon": "$(globe)"
      },
      {
        "command": "markdownBilingualSync.openPreview",
        "title": "%command.openPreview.title%",
        "category": "%command.category%",
        "icon": {
          "light": "media/bilingual-preview-light.svg",
          "dark": "media/bilingual-preview-dark.svg"
        }
      },
      {
        "command": "markdownBilingualSync.syncFile",
        "title": "%command.syncFile.title%",
        "category": "%command.category%",
        "icon": "$(sync)"
      },
      {
        "command": "markdownBilingualSync.retranslateStale",
        "title": "%command.retranslateStale.title%",
        "category": "%command.category%",
        "icon": "$(history)"
      },
      {
        "command": "markdownBilingualSync.retranslateAll",
        "title": "%command.retranslateAll.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownBilingualSync.exportTranslation",
        "title": "%command.exportTranslation.title%",
        "category": "%command.category%",
        "icon": "$(export)"
      },
      {
        "command": "markdownBilingualSync.editTranslation",
        "title": "%command.editTranslation.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "markdownBilingualSync.refreshPreview",
        "title": "%command.refreshPreview.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownBilingualSync.openTaskPanel",
        "title": "%command.openTaskPanel.title%",
        "category": "%command.category%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "markdownBilingualSync.openCacheFolder",
        "title": "%command.openCacheFolder.title%",
        "category": "%command.category%"
      },
      {
        "command": "markdownBilingualSync.clearCache",
        "title": "%command.clearCache.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "markdownBilingualSync.clearAllCaches",
        "title": "%command.clearAllCaches.title%",
        "category": "%command.category%",
        "icon": "$(clear-all)"
      },
      {
        "command": "markdownBilingualSync.importTranslation",
        "title": "%command.importTranslation.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "markdownBilingualSync.batchTranslateFolder",
        "title": "%command.batchTranslateFolder.title%",
        "category": "%command.category%",
        "icon": "$(files)"
      },
      {
        "command": "markdownBilingualSync.batchExportFolder",
        "title": "%command.batchExportFolder.title%",
        "category": "%command.category%",
        "icon": "$(file-export)"
      },
      {
        "command": "markdownBilingualSync.editGlossary",
        "title": "%command.editGlossary.title%",
        "category": "%command.category%",
        "icon": "$(book)"
      },
      {
        "command": "markdownBilingualSync.editScopedGlossary",
        "title": "%command.editScopedGlossary.title%",
        "category": "%command.category%",
        "icon": "$(book)"
      },
      {
        "command": "markdownBilingualSync.setApiKey",
        "title": "%command.setApiKey.title%",
        "category": "%command.category%",
        "icon": "$(key)"
      },
      {
        "command": "markdownBilingualSync.applyProviderPreset",
        "title": "%command.applyProviderPreset.title%",
        "category": "%command.category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "markdownBilingualSync.testApiConnection",
        "title": "%command.testApiConnection.title%",
        "category": "%command.category%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "markdownBilingualSync.clearApiKey",
        "title": "%command.clearApiKey.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "markdownBilingualSync.task.cancelAll",
        "title": "%task.cancelAll.title%",
        "icon": "$(close-all)"
      },
      {
        "command": "markdownBilingualSync.task.clearFinished",
        "title": "%task.clearFinished.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "markdownBilingualSync.task.openOutput",
        "title": "%task.openOutput.title%",
        "icon": "$(output)"
      },
      {
        "command": "markdownBilingualSync.task.languages",
        "title": "%task.languages.title%",
        "icon": "$(globe)"
      },
      {
        "command": "markdownBilingualSync.task.openSource",
        "title": "%task.openSource.title%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdownBilingualSync.task.openPreview",
        "title": "%task.openPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownBilingualSync.task.cancel",
        "title": "%task.cancel.title%",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownBilingualSync.openPreview",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation@10"
        }
      ],
      "editor/context": [
        {
          "command": "markdownBilingualSync.openPreview",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation"
        },
        {
          "command": "markdownBilingualSync.syncFile",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation"
        },
        {
          "command": "markdownBilingualSync.retranslateStale",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation"
        },
        {
          "command": "markdownBilingualSync.retranslateAll",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation"
        },
        {
          "command": "markdownBilingualSync.exportTranslation",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation"
        },
        {
          "command": "markdownBilingualSync.editTranslation",
          "when": "(editorLangId == markdown || editorLangId == skill)",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownBilingualSync.translateFile",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.openPreview",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.syncFile",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.retranslateStale",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.retranslateAll",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.exportTranslation",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.editTranslation",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.refreshPreview",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.openTaskPanel"
        },
        {
          "command": "markdownBilingualSync.clearAllCaches"
        },
        {
          "command": "markdownBilingualSync.clearCache",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.importTranslation",
          "when": "(editorLangId == markdown || editorLangId == skill)"
        },
        {
          "command": "markdownBilingualSync.batchTranslateFolder"
        },
        {
          "command": "markdownBilingualSync.batchExportFolder"
        },
        {
          "command": "markdownBilingualSync.editGlossary"
        },
        {
          "command": "markdownBilingualSync.applyProviderPreset"
        },
        {
          "command": "markdownBilingualSync.setApiKey"
        },
        {
          "command": "markdownBilingualSync.testApiConnection"
        },
        {
          "command": "markdownBilingualSync.clearApiKey"
        },
        {
          "command": "markdownBilingualSync.task.cancelAll"
        },
        {
          "command": "markdownBilingualSync.task.clearFinished"
        },
        {
          "command": "markdownBilingualSync.task.openOutput"
        },
        {
          "command": "markdownBilingualSync.task.languages"
        },
        {
          "command": "markdownBilingualSync.task.openSource",
          "when": "false"
        },
        {
          "command": "markdownBilingualSync.task.openPreview",
          "when": "false"
        },
        {
          "command": "markdownBilingualSync.task.cancel",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "markdownBilingualSync.task.cancelAll",
          "when": "view == markdownBilingualSync.tasksView",
          "group": "navigation@1"
        },
        {
          "command": "markdownBilingualSync.task.clearFinished",
          "when": "view == markdownBilingualSync.tasksView",
          "group": "navigation@2"
        },
        {
          "command": "markdownBilingualSync.task.openOutput",
          "when": "view == markdownBilingualSync.tasksView",
          "group": "navigation@3"
        },
        {
          "command": "markdownBilingualSync.task.languages",
          "when": "view == markdownBilingualSync.tasksView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownBilingualSync.task.openSource",
          "when": "view == markdownBilingualSync.tasksView && (viewItem == taskActive || viewItem == taskFinished)",
          "group": "inline@1"
        },
        {
          "command": "markdownBilingualSync.task.openPreview",
          "when": "view == markdownBilingualSync.tasksView && (viewItem == taskActive || viewItem == taskFinished)",
          "group": "inline@2"
        },
        {
          "command": "markdownBilingualSync.task.cancel",
          "when": "view == markdownBilingualSync.tasksView && viewItem == taskActive",
          "group": "inline@3"
        },
        {
          "command": "markdownBilingualSync.task.openSource",
          "when": "view == markdownBilingualSync.tasksView && (viewItem == taskActive || viewItem == taskFinished)",
          "group": "1_actions@1"
        },
        {
          "command": "markdownBilingualSync.task.openPreview",
          "when": "view == markdownBilingualSync.tasksView && (viewItem == taskActive || viewItem == taskFinished)",
          "group": "1_actions@2"
        },
        {
          "command": "markdownBilingualSync.task.cancel",
          "when": "view == markdownBilingualSync.tasksView && viewItem == taskActive",
          "group": "1_actions@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownBilingualSyncTasks",
          "title": "%viewContainer.tasks.title%",
          "icon": "media/tasks.svg"
        }
      ]
    },
    "views": {
      "markdownBilingualSyncTasks": [
        {
          "id": "markdownBilingualSync.tasksView",
          "name": "%view.tasks.name%"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "markdownBilingualSync.provider": {
          "type": "string",
          "scope": "application",
          "enum": [
            "mock",
            "openai",
            "http"
          ],
          "enumDescriptions": [
            "%configuration.provider.enumDescription.mock%",
            "%configuration.provider.enumDescription.openai%",
            "%configuration.provider.enumDescription.http%"
          ],
          "default": "mock",
          "description": "%configuration.provider.description%",
          "order": 1
        },
        "markdownBilingualSync.apiBaseUrl": {
          "type": "string",
          "scope": "application",
          "default": "https://api.openai.com/v1",
          "description": "%configuration.apiBaseUrl.description%",
          "order": 2
        },
        "markdownBilingualSync.apiModel": {
          "type": "string",
          "scope": "application",
          "default": "gpt-4o-mini",
          "description": "%configuration.apiModel.description%",
          "order": 3
        },
        "markdownBilingualSync.apiThinkingMode": {
          "type": "string",
          "scope": "application",
          "enum": [
            "default",
            "enabled",
            "disabled"
          ],
          "enumDescriptions": [
            "%configuration.apiThinkingMode.enumDescription.default%",
            "%configuration.apiThinkingMode.enumDescription.enabled%",
            "%configuration.apiThinkingMode.enumDescription.disabled%"
          ],
          "default": "default",
          "description": "%configuration.apiThinkingMode.description%",
          "order": 4
        },
        "markdownBilingualSync.apiDisableThinking": {
          "type": "boolean",
          "scope": "application",
          "default": false,
          "description": "%configuration.apiDisableThinking.description%",
          "order": 5
        },
        "markdownBilingualSync.apiBatchSize": {
          "type": "number",
          "scope": "application",
          "default": 50,
          "minimum": 1,
          "maximum": 50,
          "description": "%configuration.apiBatchSize.description%",
          "order": 6
        },
        "markdownBilingualSync.apiBatchTokenBudget": {
          "type": "number",
          "scope": "application",
          "default": 2000,
          "minimum": 500,
          "maximum": 32000,
          "description": "%configuration.apiBatchTokenBudget.description%",
          "order": 7
        },
        "markdownBilingualSync.translationConcurrency": {
          "type": "number",
          "scope": "application",
          "default": 8,
          "minimum": 1,
          "maximum": 100,
          "description": "%configuration.translationConcurrency.description%",
          "order": 8
        },
        "markdownBilingualSync.apiTimeoutMs": {
          "type": "number",
          "scope": "application",
          "default": 120000,
          "minimum": 5000,
          "maximum": 600000,
          "description": "%configuration.apiTimeoutMs.description%",
          "order": 9
        },
        "markdownBilingualSync.httpEndpoint": {
          "type": "string",
          "scope": "application",
          "default": "",
          "description": "%configuration.httpEndpoint.description%",
          "order": 20
        },
        "markdownBilingualSync.httpMethod": {
          "type": "string",
          "scope": "application",
          "enum": [
            "POST",
            "PUT",
            "PATCH"
          ],
          "default": "POST",
          "description": "%configuration.httpMethod.description%",
          "order": 21
        },
        "markdownBilingualSync.httpHeaders": {
          "type": "string",
          "scope": "application",
          "default": "{\"Content-Type\":\"application/json\",\"Authorization\":\"Bearer {{apiKey}}\"}",
          "description": "%configuration.httpHeaders.description%",
          "order": 22
        },
        "markdownBilingualSync.httpBody": {
          "type": "string",
          "scope": "application",
          "default": "{\"text\":\"{{text}}\",\"source_language\":\"{{sourceLanguage}}\",\"target_language\":\"{{targetLanguage}}\"}",
          "description": "%configuration.httpBody.description%",
          "order": 23
        },
        "markdownBilingualSync.httpResponseType": {
          "type": "string",
          "scope": "application",
          "enum": [
            "json",
            "text"
          ],
          "default": "json",
          "description": "%configuration.httpResponseType.description%",
          "order": 24
        },
        "markdownBilingualSync.httpResponsePath": {
          "type": "string",
          "scope": "application",
          "default": "translation",
          "description": "%configuration.httpResponsePath.description%",
          "order": 25
        },
        "markdownBilingualSync.sourceLanguage": {
          "type": "string",
          "default": "en",
          "description": "%configuration.sourceLanguage.description%",
          "order": 30
        },
        "markdownBilingualSync.targetLanguage": {
          "type": "string",
          "default": "zh-CN",
          "description": "%configuration.targetLanguage.description%",
          "order": 31
        },
        "markdownBilingualSync.supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "zh-CN"
          ],
          "description": "%configuration.supportedLanguages.description%",
          "order": 32
        },
        "markdownBilingualSync.stableTranslation": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%configuration.stableTranslation.description%",
          "order": 10
        },
        "markdownBilingualSync.summaryContext": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "%configuration.summaryContext.description%",
          "order": 11
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run l10n:build && node esbuild.js && node scripts/copy-katex.mjs && node scripts/copy-codicons.mjs",
    "watch": "npm run l10n:build && node scripts/copy-katex.mjs && node scripts/copy-codicons.mjs && node esbuild.js --watch",
    "pretypecheck": "npm run l10n:build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run l10n:build",
    "test": "vitest run",
    "pretest:watch": "npm run l10n:build",
    "test:watch": "vitest",
    "preview:sample": "npm run compile && tsx --tsconfig scripts/tsconfig.json scripts/render-sample.ts",
    "ui:matrix": "npm run preview:sample && tsx --tsconfig scripts/tsconfig.json scripts/capture-ui-matrix.ts",
    "ui:perf": "npm run compile && tsx --tsconfig scripts/tsconfig.json scripts/benchmark-preview.ts",
    "eval:translation": "tsx --tsconfig scripts/tsconfig.json scripts/evaluate-translation.ts",
    "package": "npm run compile && node -e \"require('node:fs').mkdirSync('artifacts/vsix',{recursive:true})\" && vsce package --readme-path README.en.md --out artifacts/vsix/markdown-bilingual-sync.vsix",
    "l10n:build": "tsx scripts/build-l10n.ts"
  },
  "dependencies": {
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vscode/codicons": "^0.0.46-24",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@testing-library/preact": "^3.2.6",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
